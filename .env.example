# GLM-OCR CLI Configuration
# Copy to .env and modify as needed

# Backend: ollama (default) or vllm
# GLM_OCR_BACKEND=ollama

# Model name
# GLM_OCR_MODEL_NAME=glm-ocr

# Ollama URL
# GLM_OCR_OLLAMA_URL=http://localhost:11434

# vLLM URL (used when backend=vllm)
# GLM_OCR_VLLM_BASE_URL=http://localhost:8080/v1

# Max image dimension (0 to disable resizing)
# GLM_OCR_MAX_DIMENSION=2048

# Output directory
# GLM_OCR_OUTPUT_DIR=output

# Retry settings
# GLM_OCR_MAX_RETRIES=3
# GLM_OCR_RETRY_DELAY=1.0
